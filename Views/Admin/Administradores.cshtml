@using System.Linq
@model IEnumerable<Grandes_Amigos.Models.ViewModels.AdminListItemViewModel>
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Administradores";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Administradores</h2>
        <a class="btn btn-primary btn-sm" asp-action="NuevoAdministrador" asp-controller="Admin">
            <i class="bi bi-person-plus"></i> Nuevo Administrador
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Nombre de usuario</th>
                            <th>Email</th>
                            <th>Ministerio</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4">No hay administradores registrados.</td>
                            </tr>
                        }
                        else
                        {
                            foreach (var admin in Model)
                            {
                                <tr>
                                    <td>@admin.ID</td>
                                    <td>@admin.NombreUsuario</td>
                                    <td>@admin.Email</td>
                                    <td>@admin.MinisterioNombre</td>
                                    <td class="text-end d-flex justify-content-end gap-2">
                                        <a class="btn btn-outline-primary btn-sm" asp-action="EditarAdministrador" asp-route-id="@admin.ID">
                                            <i class="bi bi-pencil"></i> Editar
                                        </a>
                                        <form asp-action="EliminarAdministrador" asp-route-id="@admin.ID" method="post" onsubmit="return confirm('Eliminar administrador?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
