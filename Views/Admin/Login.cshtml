@{
    Layout = ""; // Página de login sin layout del panel
    ViewData["Title"] = "Ingreso al panel";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/css/admin.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <div class="container d-flex justify-content-center align-items-center vh-100">
        <div class="card shadow p-4" style="max-width: 420px; width: 100%;">
            <div class="text-center mb-3">
                <h1 class="h5 mb-0">Ingresar al Panel</h1>
                <small class="text-secondary">Administración</small>
            </div>

            <div id="login-error" class="alert alert-danger py-2 px-3" style="display:none;"></div>

            <!-- El submit lo maneja /js/admin-login.js con fetch a /Api/Admin/Login -->
            <form id="frm-login" novalidate>
                <div class="mb-3">
                    <label class="form-label">Usuario</label>
                    <input name="NombreUsuario" class="form-control" autocomplete="username" required />
                </div>

                <div class="mb-2">
                    <label class="form-label">Contraseña</label>
                    <input name="Clave" type="password" class="form-control" autocomplete="current-password" required />
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button id="btn-submit" type="submit" class="btn btn-primary">Ingresar</button>

                    <!-- Botón de recuperar contraseña (sin acción por ahora) -->
                    <button id="btn-recuperar" type="button" class="btn btn-link">
                        ¿Olvidaste tu contraseña?
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- JS externos solamente -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin-login.js" asp-append-version="true"></script>
</body>
</html>
