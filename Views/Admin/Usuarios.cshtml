@{
    ViewData["Title"] = "Usuarios";
}

<div class="container-fluid">
    <h2 class="mb-3">Usuarios</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="d-flex gap-2 mb-3">
                <button id="btnRefrescarUsuarios" class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-arrow-repeat"></i> Refrescar
                </button>
                <button id="btnNuevoUsuario" class="btn btn-primary btn-sm">
                    <i class="bi bi-person-plus"></i> Nuevo
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>DNI</th>
                            <th>Nombre</th>
                            <th>Correo</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="tbodyUsuarios">
                        <!-- Se llena por JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin.js" asp-append-version="true"></script>
    <script src="~/js/usuarios.js" asp-append-version="true"></script>
}
