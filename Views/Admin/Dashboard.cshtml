@{
    Layout = "/Views/Shared/_LayoutAdmin.cshtml";
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div class="row g-3 mb-3">
        <div class="col-12 col-md-6 col-xxl-3">
            <div class="kpi rounded-3 p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary">Usuarios</div>
                    <div class="fs-3 fw-semibold" id="kpiUsuarios">Cargando…</div>
                </div>
                <i class="icon bi bi-people"></i>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xxl-3">
            <div class="kpi rounded-3 p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary">Eventos</div>
                    <div class="fs-3 fw-semibold" id="kpiEventos">Cargando…</div>
                </div>
                <i class="icon bi bi-calendar-event"></i>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xxl-3">
            <div class="kpi rounded-3 p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary">Noticias</div>
                    <div class="fs-3 fw-semibold" id="kpiNoticias">—</div>
                </div>
                <i class="icon bi bi-newspaper"></i>
            </div>
        </div>
        <div class="col-12 col-md-6 col-xxl-3">
            <div class="kpi rounded-3 p-3 d-flex align-items-center justify-content-between">
                <div>
                    <div class="small text-secondary">Sesión</div>
                    <div class="fs-6 fw-semibold" id="kpiSesion">Cargando…</div>
                </div>
                <i class="icon bi bi-person-badge"></i>
            </div>
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-body d-flex gap-2 flex-wrap">
            <a href="/Admin/Eventos/Nuevo" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Nuevo evento</a>
            <a href="#" id="btnCargarNoticias" class="btn btn-outline-light"><i class="bi bi-rss me-1"></i>Cargar noticias (RSS)</a>
            <a href="/Admin/Usuarios" class="btn btn-outline-light"><i class="bi bi-people me-1"></i>Gestionar usuarios</a>
        </div>
    </div>

    <div class="card">
        <div class="card-header d-flex align-items-center justify-content-between">
            <span class="fw-semibold">Próximos eventos</span>
            <a href="/Admin/Eventos" class="btn btn-sm btn-outline-light">Ver todos</a>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table align-middle m-0">
                    <thead>
                        <tr>
                            <th>Título</th>
                            <th>Fecha</th>
                            <th>Ministerio (ID)</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody id="tblEventos">
                        <tr><td colspan="4" class="text-center py-4 text-secondary">Cargando…</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="/js/dashboard.js"></script>
}