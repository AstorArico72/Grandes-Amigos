@model Grandes_Amigos.Models.ViewModels.DashboardViewModel

<div class="card shadow-sm">
    <div class="card-header bg-white">
        <strong>Eventos recientes</strong>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Título</th>
                        <th>Fecha</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <a href="NuevoEvento">
                    <button class="btn btn-primary btn-sm">
                        <i class="bi"></i> Nuevo
                    </button>
                </a>
                <tbody id="tblEventos">
                    @if (Model?.EventosRecientes?.Any() == true)
                    {
                        foreach (var ev in Model.EventosRecientes)
                        {
                            <tr>
                                <td>@(ev.Título ?? "(sin título)")</td>
                                <td>@ev.Fecha.ToString("dd/MM/yyyy")</td>
                                <td class="text-end">
                                    <a href="#" class="btn btn-sm btn-outline-primary">Ver</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center p-4 text-secondary">
                                Sin eventos recientes
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
