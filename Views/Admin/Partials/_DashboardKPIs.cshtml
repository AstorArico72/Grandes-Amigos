@model Grandes_Amigos.Models.ViewModels.DashboardViewModel
@{
    var adminNombre = User?.FindFirst("AdminNombre")?.Value ?? User?.Identity?.Name ?? "-";
}

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card text-bg-primary">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="small text-uppercase opacity-75">Usuarios</div>
                        <div class="fs-3 fw-bold">
                            <span id="kpiUsuarios">@Model.TotalUsuarios</span>
                        </div>
                    </div>
                    <i class="bi bi-people fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card text-bg-success">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="small text-uppercase opacity-75">Eventos</div>
                        <div class="fs-3 fw-bold">
                            <span id="kpiEventos">@Model.TotalEventos</span>
                        </div>
                    </div>
                    <i class="bi bi-calendar-event fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card text-bg-dark">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <div class="small text-uppercase opacity-75">Sesion</div>
                        <div class="fs-3 fw-bold"><span id="kpiSesion">@adminNombre</span></div>
                    </div>
                    <i class="bi bi-person-badge fs-1 opacity-50"></i>
                </div>
            </div>
        </div>
    </div>
</div>
