@using System
@{
    var adminNombre = User?.FindFirst("AdminNombre")?.Value ?? User?.Identity?.Name;
    var adminMinisterio = User?.FindFirst("AdminMinisterio")?.Value ?? User?.FindFirst("IdMinisterio")?.Value;
    var esSuperAdmin = adminMinisterio == "1";
}

<aside class="admin-sidebar">

    <div class="p-3 border-bottom border-opacity-10">
        <div class="d-flex align-items-center gap-2">
            <i class="bi bi-grid-1x2 fs-5 text-secondary-200"></i>
            <span class="fw-semibold text-secondary-200">Tablero</span>
        </div>
    </div>

    <nav class="nav flex-column p-2">
        <a class="nav-link" asp-controller="Admin" asp-action="Dashboard">
            <i class="bi bi-grid"></i> Dashboard
        </a>
        <a class="nav-link" asp-controller="Admin" asp-action="Usuarios">
            <i class="bi bi-people"></i> Usuarios
        </a>

        <!-- Nueva entrada: Eventos -->
        <!--
        <a class="nav-link" asp-controller="Admin" asp-action="NuevoEvento">
            <i class="bi bi-calendar-event"></i> Eventos
        </a>
        -->

        @if (esSuperAdmin)
        {
            <a class="nav-link" asp-controller="Admin" asp-action="Ministerios">
                <i class="bi bi-building"></i> Ministerios
            </a>
        }

        @if (esSuperAdmin)
        {
            <a class="nav-link" asp-controller="Admin" asp-action="Administradores">
                <i class="bi bi-shield-lock"></i> Administradores
            </a>
        }
    </nav>
</aside>
