<aside class="sidebar d-flex flex-column">
    <div class="sidebar-header">
        <i class="bi bi-shield-lock text-success"></i>
        <span class="brand">Grandes Amigos · Admin</span>
    </div>
    <hr class="text-white-50" />
    <nav class="nav flex-column">
        <a class="nav-link" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-grid me-2"></i>Dashboard</a>
        <a class="nav-link" asp-controller="Admin" asp-action="Usuarios"><i class="bi bi-people me-2"></i>Usuarios</a>
        <a class="nav-link" asp-controller="Admin" asp-action="Eventos"><i class="bi bi-calendar-event me-2"></i>Eventos</a>
        <a class="nav-link" asp-controller="Admin" asp-action="Noticias"><i class="bi bi-newspaper me-2"></i>Noticias</a>
    </nav>
    <div class="sidebar-footer">
        <i class="bi bi-info-circle me-1"></i> Sesión: <span>@User.Identity.Name</span>
        <a asp-controller="Auth" asp-action="Logout" class="btn btn-outline-light btn-sm mt-2 w-100">
            <i class="bi bi-box-arrow-right me-1"></i>Salir
        </a>
    </div>
</aside>