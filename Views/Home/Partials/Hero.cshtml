@model Grandes_Amigos.Models.ConfigHero

<section class="hero" style="background-image: url('@Model.ImagenUrl'); background-size: cover; background-position: center; padding: 100px 0;">
    <div class="text-center text-white bg-dark bg-opacity-50 p-5 rounded">
        <h1 class="display-4">@Model.Titulo</h1>
        <p class="lead">@Model.Subtitulo</p>
        <a href="#inscribirse" class="btn btn-primary btn-lg mt-3">@Model.TextoBoton</a>
    </div>
</section>
