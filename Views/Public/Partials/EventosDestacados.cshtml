@model IEnumerable<Grandes_Amigos.Models.ViewModels.EventoConMinisterioViewModel>

<section id="eventos-destacados" class="seccion-eventos-destacados seccion-animada">
    <div class="container text-center">
        <h2 class="titulo-ovalo">Eventos Destacados</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4 mt-4">
            @foreach (var evento in Model)
            {
                @await Html.PartialAsync("~/Views/Public/Partials/TarjetaEventoDestacado.cshtml", evento)
            }
        </div>
    </div>
</section>
