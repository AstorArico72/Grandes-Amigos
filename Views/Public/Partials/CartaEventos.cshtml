@model Grandes_Amigos.Models.Evento

@{
    var numero = ViewData["EncuentroNro"]?.ToString() ?? "#";
}

<div class="evento-card bg-info bg-opacity-75 text-white rounded shadow-sm p-3 mb-4">
    <div class="row align-items-center g-3">
        <!-- Número de encuentro -->
        <div class="col-auto">
            <div class="bg-white text-primary text-center rounded-3 px-3 py-2">
                <div class="fw-bold fs-5">@numero&#186;</div>
                <small class="text-uppercase fw-bold">Encuentro</small>
            </div>
        </div>

        <!-- Detalles -->
        <div class="col">
            <div class="fw-bold mb-1">
                <i class="bi bi-clock me-1"></i>
                @Model.Fecha.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("es-ES")).ToUpper()
            </div>
            <div class="mb-1">
                <strong>Departamento:</strong> Ministerio ID @Model.ID_Ministerio
            </div>
            <div>
                <i class="bi bi-geo-alt-fill me-1"></i> @Model.Título
            </div>
        </div>

        <!-- Botón -->
        <div class="col-auto">
            <button class="btn btn-success btn-inscribirse"
                    data-evento-id="@Model.ID"
                    data-bs-toggle="modal"
                    data-bs-target="#inscripcionModal">
                Inscribirse
            </button>
        </div>
    </div>
</div>
