@model Grandes_Amigos.Models.ViewModels.EventoConMinisterioViewModel

@{
    var numero = ViewData["EncuentroNro"]?.ToString() ?? "#";
}

<div class="evento-card bg-info bg-opacity-75 text-white rounded shadow-sm p-3 mb-4">
    <div class="row align-items-center g-3">
        <div class="col">
            <h4 class="fw-bold mb-1">
                @Model.Evento.Título
            </h4>
            <div class="fw-bold mb-1">
                <i class="bi bi-clock me-1"></i>
                @Model.Evento.Fecha.ToString("dd 'de' MMMM", new System.Globalization.CultureInfo("es-ES"))
            </div>
            <div class="mb-1">
                <strong>Ministerio:</strong> @Model.NombreMinisterio
            </div>
        </div>
        <div class="col-auto">
            <button class="btn btn-success btn-inscribirse"
                    data-evento-id="@Model.Evento.ID"
                    data-bs-toggle="modal"
                    data-bs-target="#inscripcionModal">
                Inscribirse
            </button>
        </div>
    </div>
</div>
