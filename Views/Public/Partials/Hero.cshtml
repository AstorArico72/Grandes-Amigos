

@{
    Layout = "~/Views/Shared/_Layout.cshtml"; // layout del sitio público
    ViewData["Title"] = "Grandes Amigos – Inicio";
}

<section class="hero d-flex align-items-center" style="background-image: url('/img/hero1.png'); background-size: cover; background-position: center; height: 90vh;">
    <div class="container text-center text-white bg-dark bg-opacity-50 p-4 rounded">
        <h1 class="display-4 fw-bold">Grandes Amigos</h1>
        <p class="lead">Conectando a la Tercera Edad con actividades, bienestar y comunidad</p>
        <a href="#ministerios" class="btn btn-lg btn-light mt-3">Ver ministerios</a>
    </div>
</section>

<section id="objetivo" class="py-5 bg-light">
    <div class="container">
        <h2 class="mb-4">¿Qué es Grandes Amigos?</h2>
        <p>
            Grandes Amigos es una iniciativa que busca acercar a los adultos mayores a las propuestas y actividades de distintos ministerios de San Luis.
            Es un puente para promover su participación activa, la interacción social y el acceso a programas culturales, recreativos y educativos.
        </p>
    </div>
</section>

<section id="ministerios" class="py-5">
    <div class="container">
        <h2 class="mb-4">Actividades por Ministerio</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">ULP</h5>
                        <p class="card-text">Cursos, talleres y actividades tecnológicas.</p>
                        <a href="/ministerio/ulp" class="btn btn-outline-primary">Ver más</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Turismo</h5>
                        <p class="card-text">Excursiones y paseos para disfrutar de la provincia.</p>
                        <a href="/ministerio/turismo" class="btn btn-outline-primary">Ver más</a>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card h-100 border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Salud</h5>
                        <p class="card-text">Jornadas de salud, chequeos y promoción del bienestar.</p>
                        <a href="/ministerio/salud" class="btn btn-outline-primary">Ver más</a>
                    </div>
                </div>
            </div>
            <!-- Agregar más ministerios si es necesario -->
        </div>
    </div>
</section>

