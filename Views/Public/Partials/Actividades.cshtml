<section id="ministerios" class="seccion-ministerios seccion-animada">
    <div class="container text-center">
        <h2 class="titulo-ovalo">Actividades por Ministerio</h2>

        <div id="ministerios-container" class="row row-cols-1 row-cols-md-3 g-4 mt-4"></div>
    </div>
</section>

<div class="modal fade" id="modalEventosMinisterio" tabindex="-1" aria-labelledby="modalEventosMinisterioLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalEventosMinisterioLabel">Eventos por ministerio</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div id="modalEventosAlert" class="alert alert-danger d-none"></div>
                <div id="modalEventosSpinner" class="text-center py-4">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
                <div id="modalEventosContenido" class="row g-3"></div>
            </div>
        </div>
    </div>
</div>
