@model Grandes_Amigos.Models.Noticia

<div class="card shadow-sm border-0 noticia-card">
    @if (!string.IsNullOrEmpty(Model.ImagenUrl))
    {
        <img src="@Model.ImagenUrl" class="card-img-top" alt="Imagen de la noticia">
    }
    <div class="card-body d-flex flex-column">
        <h5 class="card-title">@Model.Título</h5>
        <p class="card-text">@Model.Contenido</p>
        <div class="mt-auto">
            <small class="text-muted d-block">Por @Model.Autor</small>
            <small class="text-muted">@Model.FechaPublicación.ToShortDateString()</small>
        </div>
    </div>
</div>
