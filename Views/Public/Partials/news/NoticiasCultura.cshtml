@model List<Grandes_Amigos.Models.Noticia>

<section class="py-5 seccion-animada">
    <div class="container">

        <div id="carouselNoticias" class="carousel slide mt-4" data-bs-ride="carousel">
            <div class="carousel-inner">
                @{
                    int total = Model.Count;
                    int grupos = (int)Math.Ceiling(total / 3.0);
                    for (int i = 0; i < grupos; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row row-cols-1 row-cols-md-3 g-4">
                                @for (int j = i * 3; j < (i + 1) * 3 && j < total; j++)
                                {
                                    <div class="col">
                                        @await Html.PartialAsync("~/Views/Public/Partials/news/Card.cshtml", Model[j])
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#carouselNoticias" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Anterior</span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#carouselNoticias" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
                <span class="visually-hidden">Siguiente</span>
            </button>
        </div>
    </div>
</section>
