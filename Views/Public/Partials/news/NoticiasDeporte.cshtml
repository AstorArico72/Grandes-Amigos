@model List<Grandes_Amigos.Models.Noticia>

<section class="py-5 bg-light">
    <div class="container">
        <h2 class="mb-4 text-center">Noticias de Deporte</h2>
        <div class="row row-cols-1 row-cols-md-3 g-4">
            @foreach (var noticia in Model)
            {
                @await Html.PartialAsync("~/Views/Public/Partials/news/Card.cshtml", noticia)

            }
        </div>
    </div>
</section>
