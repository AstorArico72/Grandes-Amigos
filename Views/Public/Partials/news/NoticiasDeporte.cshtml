@model List<Grandes_Amigos.Models.Noticia>

<section class="py-5 seccion-animada">
    <div class="container">

        <div id="carouselDeporte" class="carousel slide mt-4" data-bs-ride="carousel">
            <div class="carousel-inner">
                @{
                    int noticiasPorSlide = Model.Count < 3 ? 1 : 3;
                    int total = Model.Count;
                    int grupos = (int)Math.Ceiling((double)total / noticiasPorSlide);

                    for (int i = 0; i < grupos; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <div class="row row-cols-1 row-cols-md-@noticiasPorSlide g-4">
                                @for (int j = i * noticiasPorSlide; j < (i + 1) * noticiasPorSlide && j < total; j++)
                                {
                                    <div class="col">
                                        @await Html.PartialAsync("~/Views/Public/Partials/news/Card.cshtml", Model[j])
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* Solo mostrar flechas si hay más de una slide *@
            @if (grupos > 1)
            {
                <button class="carousel-control-prev" type="button" data-bs-target="#carouselDeporte" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon bg-dark rounded-circle" aria-hidden="true"></span>
                    <span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#carouselDeporte" data-bs-slide="next">
                    <span class="carousel-control-next-icon bg-dark rounded-circle" aria-hidden="true"></span>
                    <span class="visually-hidden">Siguiente</span>
                </button>
            }
        </div>
    </div>
</section>
