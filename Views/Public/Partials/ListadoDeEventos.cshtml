@model IEnumerable<Grandes_Amigos.Models.Evento>

<section id="eventos" class="seccion-listado-eventos seccion-animada">
    <div class="container text-center">
        <h2 class="titulo-ovalo">Listado de Eventos</h2>

        <div class="row row-cols-1 row-cols-md-2 g-4 mt-4 text-start">
            @{
                int contador = 1;
            }
            @foreach (var evento in Model)
            {
                <div class="col">
                    @await Html.PartialAsync("~/Views/Public/Partials/CartaEventos.cshtml", evento, new ViewDataDictionary(ViewData)
                    {
                        { "EncuentroNro", contador++ }
                    })
                </div>
            }
        </div>
    </div>
</section>

@await Html.PartialAsync("~/Views/Public/Partials/InscripcionModalEvento.cshtml")