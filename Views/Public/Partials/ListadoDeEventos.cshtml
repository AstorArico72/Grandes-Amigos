@model IEnumerable<Grandes_Amigos.Models.Evento>

<section style="background-color: #4cacca;" class="py-5" id="eventos">
    <div class="container">
        <h2 class="mb-4 text-center text-uppercase text-primary fw-bold text-white">Listado de Eventos</h2>
        <div class="row row-cols-1 row-cols-md-2 g-4">
            @{
                int contador = 1;
            }
            @foreach (var evento in Model)
            {
                <div class="col">
                    @await Html.PartialAsync("~/Views/Public/Partials/CartaEventos.cshtml", evento, new ViewDataDictionary(ViewData)
                    {
                        { "EncuentroNro", contador++ }
                    })
                </div>
            }
        </div>
    </div>
</section>
