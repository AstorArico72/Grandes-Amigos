<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Admin | Grandes Amigos</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/admin.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>
<body class="d-flex">

    <!-- Sidebar -->
    <div class="sidebar-admin d-flex flex-column p-3">
        <h4 class="text-white text-center mb-4">Grandes Amigos</h4>
        <ul class="nav nav-pills flex-column mb-auto">
            <li><a class="nav-link" href="/Admin/Dashboard"><i class="fas fa-home me-2"></i>Inicio</a></li>
            <li><a class="nav-link" href="/Admin/Eventos"><i class="fas fa-calendar-alt me-2"></i>Eventos</a></li>
            <li><a class="nav-link" href="/Admin/Noticias"><i class="fas fa-newspaper me-2"></i>Noticias</a></li>
        </ul>
    </div>

    <!-- Contenido principal -->
    <div class="flex-grow-1 d-flex flex-column">

        <!-- Navbar superior -->
        <nav class="navbar navbar-dark navbar-expand-lg navbar-admin">
            <div class="container-fluid">
                <span class="navbar-brand ms-3">Panel Administrativo</span>
                <ul class="navbar-nav ms-auto me-3">
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin/Logout">
                            <i class="fas fa-sign-out-alt me-1"></i>Salir
                        </a>
                    </li>
                </ul>
            </div>
        </nav>

        <main class="container-fluid p-4">
            @RenderBody()
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/admin.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>
