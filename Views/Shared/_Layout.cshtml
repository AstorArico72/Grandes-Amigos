<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Grandes Amigos</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Url.Content("~/css/publico.css")" />

    @RenderSection("EstilosExtra", required: false)
</head>
<body class="d-flex flex-column min-vh-100">

    @await Html.PartialAsync("~/Views/Public/Partials/Header.cshtml")

    <main class="flex-fill main-con-fondo">
        @RenderBody()
    </main>

    @await Html.PartialAsync("~/Views/Public/Partials/Footer.cshtml")

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("ScriptsExtra", required: false)
</body>
</html>
